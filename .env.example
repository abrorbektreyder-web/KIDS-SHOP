# Set these in Vercel Project Settings > Environment Variables. Never commit real values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server-only Supabase secret key (sb_secret_...). Never expose in browser code.
SUPABASE_SECRET_KEY=your-server-only-secret-key
# Legacy fallback only; migrate away from service_role JWT keys.
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-server-only-service-role-key
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_GROUP_ID=-1001234567890
ORDERS_ENABLED=false
# Admin sign-in values (used by api/admin.js when added/configured).
ADMIN_PASSWORD=use-a-long-unique-password
ADMIN_SESSION_SECRET=generate-a-random-secret-at-least-32-characters
